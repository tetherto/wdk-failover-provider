{
  "name": "@tetherto/wdk-failover-provider",
  "version": "1.0.0-beta.4",
  "description": "Provider failover utilities for WDK (Wallet Development Kit) by Tether.",
  "homepage": "https://docs.wdk.tether.io/tools/failover-provider/",
  "keywords": [
    "wdk",
    "wallet",
    "failover"
  ],
  "author": "Tether",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetherto/wdk-failover-provider.git"
  },
  "main": "index.js",
  "type": "module",
  "types": "./types",
  "scripts": {
    "build:types": "tsc",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --testPathIgnorePatterns=/tests/integration/",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage --testPathIgnorePatterns=/tests/integration/",
    "test:integration-wait": "wait-on tcp:127.0.0.1:8545 && cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/integration --runInBand",
    "test:integration": "concurrently -k -s first -n \"NODE,TEST\" -c \"black,green\" --hide NODE \"npx hardhat node --network hardhat\" \"npm run test:integration-wait\""
  },
  "devDependencies": {
    "concurrently": "9.2.0",
    "cross-env": "10.1.0",
    "ethers": "6.17.0",
    "hardhat": "3.12.0",
    "jest": "30.2.0",
    "standard": "17.1.2",
    "typescript": "5.9.3",
    "wait-on": "8.0.4"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    },
    "./package": {
      "default": "./package.json"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "standard": {
    "ignore": [
      "bare.js",
      "tests/**/*.js"
    ]
  }
}
